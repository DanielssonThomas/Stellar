{
  "compilerOptions": {
    "baseUrl": ".",
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@stellar/source"],
    "paths": {
      "@stellar/ui-atoms": ["libs/ui/atoms/src/index.ts"],
      "@stellar/generators": ["tools/generators/src/index.ts"],
      "@stellar/ui-molecules": ["libs/ui/molecules/src/index.ts"],
      "@stellar/ui-templates": ["libs/mission-control/src/index.ts"],
      "@stellar/ui-templates/desktop-experience": [
        "libs/mission-control/desktop-experience/index.ts"
      ],
      "@stellar/service-dashboard-status": [
        "libs/dashboard-status/src/index.ts"
      ],
      "@stellar/test-support": ["tools/testing/msw.ts"],
      "@stellar/desktop-interaction": ["libs/desktop-interaction/src/index.ts"],
      "@stellar/ui-organisms": ["libs/ui/organisms/src/index.ts"],
      "@stellar/service-audio-activity": [
        "libs/services/audio-activity/src/index.ts"
      ],
      "@stellar/desktop-contracts": ["libs/desktop-contracts/src/index.ts"],
      "@stellar/service-desktop-adapter": [
        "libs/services/desktop-adapter/src/index.ts"
      ]
    }
  }
}
