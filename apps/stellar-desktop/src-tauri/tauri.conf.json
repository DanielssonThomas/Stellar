{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stellar Desktop",
  "version": "0.1.0",
  "identifier": "dev.stellar.desktop",
  "build": { "frontendDist": "../../../dist/apps/stellar-desktop/browser" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Stellar Desktop",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 360,
        "decorations": true,
        "resizable": true,
        "devtools": false
      }
    ],
    "security": {
      "capabilities": ["desktop-main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
