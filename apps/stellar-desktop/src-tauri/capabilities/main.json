{
  "identifier": "desktop-main",
  "description": "The local desktop shell may read its versioned readiness contract.",
  "windows": ["main"],
  "permissions": [
    "allow-shell-status",
    "allow-cleanup-refine",
    "allow-app-info",
    "allow-telemetry-snapshot",
    "allow-ivy-connect",
    "allow-ivy-snapshot",
    "allow-ivy-submit",
    "allow-ivy-cancel",
    "allow-ivy-reconcile",
    "allow-ivy-disconnect",
    "allow-ivy-select-session",
    "allow-ivy-clear-conversation",
    "allow-workspace-tool-reply",
    "allow-speech-transcribe",
    "allow-speech-speak",
    "allow-speech-stop",
    "allow-speech-snapshot",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
