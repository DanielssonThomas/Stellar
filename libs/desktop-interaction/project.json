{
  "name": "util-desktop-interaction",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/desktop-interaction/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:util"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/desktop-interaction",
        "main": "libs/desktop-interaction/src/index.ts",
        "tsConfig": "libs/desktop-interaction/tsconfig.lib.json",
        "assets": ["libs/desktop-interaction/*.md"]
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "coverage/libs/desktop-interaction"
      }
    }
  }
}
