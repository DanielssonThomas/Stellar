{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stellar Desktop Feasibility Probe",
  "version": "0.1.0",
  "identifier": "dev.stellar.feasibility",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Stellar Desktop Feasibility Probe",
        "width": 900,
        "height": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; media-src 'self' blob:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
