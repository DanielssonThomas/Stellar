FROM docker.io/library/node:22-bookworm-slim@sha256:efd0ab5780c2d9ab1f0f869571a00d5edb17793bff4cce4a2792e3eb0ffc7562

ARG HERMES_COMMIT=d923a5eb487a17c0a68801bba9ef0f56c81040a8

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git libatomic1 python3 python3-venv ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@10.28.2 --activate \
    && groupadd --gid 1001 peon \
    && useradd --create-home --uid 1001 --gid 1001 --shell /bin/bash peon \
    && install -d -o peon -g peon /opt/hermes

RUN COREPACK_HOME=/opt/corepack corepack prepare pnpm@10.28.2 --activate \
    && chmod -R a+rX /opt/corepack

USER 1001:1001
ENV HOME=/home/peon \
    HERMES_HOME=/opt/hermes \
    PATH=/home/peon/.local/bin:/opt/hermes/hermes-agent/.venv/bin:${PATH}

RUN curl --fail --silent --show-error --location \
        "https://raw.githubusercontent.com/NousResearch/hermes-agent/${HERMES_COMMIT}/scripts/install.sh" \
        --output /tmp/hermes-install.sh \
    && bash /tmp/hermes-install.sh \
        --commit "${HERMES_COMMIT}" \
        --dir /opt/hermes/hermes-agent \
        --hermes-home /opt/hermes \
        --non-interactive \
        --skip-browser \
        --skip-computer-use \
    && rm /tmp/hermes-install.sh \
    && hermes pm repair \
    && hermes --version | grep --fixed-strings 'v0.22.2'

ENV HERMES_RUNTIME_DIR=/opt/hermes/tools
COPY --chown=0:0 tools/worker-image/verify-hermes-runtime.py /usr/local/libexec/verify-hermes-runtime.py
USER 1001:1001
RUN venv_python="$(python3 -c 'import json; from pathlib import Path; p=Path("/opt/hermes/installs"); f=next(p.glob("*/facts.json")); print(json.loads(f.read_text())["packages"]["venv"]["environment"] + "/bin/python")')" \
    && "${venv_python}" /usr/local/libexec/verify-hermes-runtime.py \
    && hermes skills list >/dev/null

USER 0:0
COPY --chown=0:0 tools/policy/peon-metering-proxy.mjs /opt/stellar-peon-metering-proxy.mjs
RUN set -eu \
    && install_dir="$(find /opt/hermes/installs -mindepth 1 -maxdepth 1 -type d -print -quit)" \
    && environment_dir="$(python3 -c 'import json; from pathlib import Path; p=Path("/opt/hermes/installs"); f=next(p.glob("*/facts.json")); print(json.loads(f.read_text())["packages"]["venv"]["environment"])')" \
    && generation_dir="$(python3 -c 'import json; from pathlib import Path; p=Path("/opt/hermes/installs"); i=next(p.glob("*")); r=i/"pm-runtime"; s=json.loads((r/"selected.json").read_text()); print(r/s["generation"])')" \
    && test -n "${install_dir}" \
    && test -n "${environment_dir}" \
    && case "${environment_dir}" in "${install_dir}"/environments/*) ;; *) exit 1 ;; esac \
    && case "${generation_dir}" in "${install_dir}"/pm-runtime/generations/*) ;; *) exit 1 ;; esac \
    && rm "${install_dir}/.install.lock" \
    && ln -s /tmp/hermes-install.lock "${install_dir}/.install.lock" \
    && rm -f "${install_dir}/pm-runtime/.prepare.lock" \
    && ln -s /tmp/hermes-prepare.lock "${install_dir}/pm-runtime/.prepare.lock" \
    && rm -rf "${environment_dir}/.leases" \
    && rm -rf "$(dirname "${environment_dir}")/.leases" \
    && ln -s /tmp/hermes-leases "$(dirname "${environment_dir}")/.leases" \
    && rm -rf "${generation_dir}/.leases" \
    && ln -s /tmp/hermes-leases "${generation_dir}/.leases" \
    && rm -rf /opt/hermes/skills/.hub \
    && install -d /usr/local/libexec \
    && printf '%s\n' \
        '#!/bin/sh' \
        'set -eu' \
        'mkdir -p /tmp/.hermes /tmp/hermes-leases /tmp/.hermes/skills' \
        'touch /tmp/hermes-install.lock /tmp/hermes-prepare.lock' \
        'ln -s /opt/hermes/installs /tmp/.hermes/installs' \
        'ln -s /opt/hermes/tools /tmp/.hermes/tools' \
        'for skill in /opt/hermes/skills/* /opt/hermes/skills/.[!.]*; do' \
        '  [ -e "$skill" ] || continue' \
        '  ln -s "$skill" "/tmp/.hermes/skills/${skill##*/}"' \
        'done' \
        'export GIT_ASKPASS=/usr/local/libexec/hermes-worker-git-askpass' \
        'export GIT_TERMINAL_PROMPT=0' \
        'exec "$@"' \
        > /usr/local/libexec/hermes-worker-entrypoint \
    && chmod 0755 /usr/local/libexec/hermes-worker-entrypoint \
    && printf '%s\n' \
        '#!/bin/sh' \
        'set -eu' \
        'case "${1-}" in' \
        '  *Username*) printf "%s\\n" x-access-token ;;' \
        '  *Password*) printf "%s\\n" "${GH_TOKEN:?GH_TOKEN is required}" ;;' \
        '  *) exit 1 ;;' \
        'esac' \
        > /usr/local/libexec/hermes-worker-git-askpass \
    && chmod 0755 /usr/local/libexec/hermes-worker-git-askpass \
    && chmod 0444 /opt/stellar-peon-metering-proxy.mjs

USER 1001:1001
ENV HOME=/tmp \
    HERMES_HOME=/tmp/.hermes \
    HERMES_RUNTIME_DIR=/opt/hermes/tools \
    COREPACK_HOME=/opt/corepack \
    COREPACK_DEFAULT_TO_LATEST=0 \
    COREPACK_ENABLE_NETWORK=0

WORKDIR /workspace
ENTRYPOINT ["/usr/local/libexec/hermes-worker-entrypoint"]
CMD ["hermes", "--help"]
